# SGC-UERN - Configuração de Variáveis de Ambiente

# 1. Banco de Dados PostgreSQL (Neon Tech / Supabase / Local UERN)
# Para Neon na Nuvem (com PgBouncer para Serverless / Vercel):
DATABASE_URL="postgresql://usuario:senha@host-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true"

# Conexão direta para migrações do Prisma (sem passar pelo pooler):
DIRECT_URL="postgresql://usuario:senha@host.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Para Servidor Local na UERN (Docker / On-Premise):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgc_uern?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sgc_uern?schema=public"

# 2. Segurança e Assinatura de Sessões JWT
JWT_SECRET="sua_chave_secreta_super_segura_proad_uern_2026"

# 3. URL Base da Aplicação (Produção Vercel)
NEXT_PUBLIC_APP_URL="https://sgc-uern.vercel.app"

# 4. Integração e SSO com Portal PROAD
PROAD_SSO_SECRET="sua_chave_mestra_sso_portal_proad"
PROAD_SERVICE_KEY="sua_chave_de_servico_interoperabilidade"
PORTAL_PROAD_URL="https://portal-proad.vercel.app"
PCA_URL="https://pca-uern.vercel.app"
