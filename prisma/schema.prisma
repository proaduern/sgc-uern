datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN_PROAD
  ADMIN_PARCIAL
  GESTOR
  SUPLENTE
  FISCAL_ADMINISTRATIVO
  FISCAL_TECNICO
  FISCAL_SETORIAL
  FORNECEDOR
  GESTOR_ATA
}

enum TipoVigencia {
  CONTINUADO
  NAO_CONTINUADO
  LOCACAO_IMOVEL
}

enum TipoContrato {
  FORNECIMENTO_CONTINUADO
  FORNECIMENTO_SIMPLES
  SERVICO_SEM_DEDICACAO
  SERVICO_COM_DEDICACAO_TERCEIRIZACAO
  LOCACAO_IMOVEL
  SERVICOS_TECNICOS_PROFISSIONAIS
  OBRA
}

enum TipoEmpreitada {
  PRECO_UNITARIO
  PRECO_GLOBAL
  EMPREITADA_INTEGRAL
  ESCOPO
  TAREFA
  CONTRATACAO_INTEGRADA
  CONTRATACAO_SEMI_INTEGRADA
  FORNECIMENTO_SERVICO_ASSOCIADO
}

enum TipoMedicao {
  ENTREGA_UNICA
  MENSAL
  POR_DEMANDA
  POR_EVENTO
  PERIODO_VARIAVEL
}

enum StatusContrato {
  ATIVO
  INATIVO
  SUSPENSO
  RESCINDIDO
  ENCERRADO
}

enum TipoIndiceReajuste {
  IPCA
  SETORIAL
  CONVENCAO_COLETIVA
}

enum StatusMedicao {
  AGUARDANDO_ENVIO_NF
  EM_CONFERENCIA_ADM
  ATESTE_PROVISORIO_TECNICO
  ATESTE_DEFINITIVO_GESTOR
  ENVIADO_PAGAMENTO_PROPLAN
  LIQUIDADO_PAGO
}

enum RubricaContaVinculada {
  FERIAS_8_33
  TERCO_FERIAS_2_78
  DECIMO_TERCEIRO_8_33
  FGTS_SOBRE_PROVISOES
  MULTA_RESCISORIA_FGTS
}

enum TipoOperacaoContaVinculada {
  RETENCAO_ENTRADA
  LIBERACAO_SAIDA
}

enum TipoPenalidade {
  ADVERTENCIA
  MULTA
  IMPEDIMENTO_LICITAR_ATE_3_ANOS
  DECLARACAO_INIDONEIDADE
}

enum StatusPenalidade {
  NOTIFICACAO_DEFESA_15_DIAS
  EM_ANALISE_DEFESA
  RECURSO_15_DIAS_SUSPENSIVO
  PENALIDADE_APLICADA
  REGISTRADO_SICAF
  ARQUIVADO
}

enum NivelAlerta {
  INFO
  ALERTA
  CRITICO
}

// 1. Usuários e Autenticação (Desacoplada para servidores UERN)
model User {
  id                 String   @id @default(uuid())
  nome               String
  email              String   @unique
  matricula          String?
  senhaHash          String
  role               Role     @default(FISCAL_ADMINISTRATIVO)
  deveTrocarSenha    Boolean  @default(true) // Força troca no 1º acesso (padrão 123)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relações
  contratosDesignados ContratoResponsavel[]
  ordensServico       OrdemServico[]
  normativosCriados   Normativo[]
  alertas             AlertaSistema[]
  atasGerenciadas     AtaRegistroPreco[]
  fornecedor          Fornecedor?
  rascunhosContrato   ContratoRascunho[]
  alteracoesCriadas   ContratoAlteracao[]

  @@map("usuarios")
}

// 2. Normativos e Legislações da UERN (IN 01/2026, IN 05/2017, etc.)
model Normativo {
  id            String   @id @default(uuid())
  titulo        String
  tipo          String   // INSTRUCAO_NORMATIVA, LEI, DECRETO, CADERNO_LOGISTICA, PORTARIA
  numero        String?
  ano           Int?
  orgaoEmissor  String   @default("PROAD/UERN")
  descricao     String?
  arquivoUrl    String
  criadoPorId   String?
  criadoPor     User?    @relation(fields: [criadoPorId], references: [id])
  createdAt     DateTime @default(now())

  @@map("normativos")
}

// 3. Fornecedores
model Fornecedor {
  id                  String   @id @default(uuid())
  razaoSocial         String
  nomeFantasia        String?
  cnpj                String   @unique
  email               String
  telefone            String?
  endereco            String?
  nomeRepresentanteLegal      String?
  cpfRepresentanteLegal       String?
  telefoneRepresentanteLegal  String?
  emailRepresentanteLegal     String?
  nomePreposto                String?
  telefonePreposto            String?
  emailPreposto               String?
  statusSicaf                 String   @default("REGULAR")
  scoreConfiabilidade Float    @default(100.0) // Reduzido por penalidades e glosas
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relações
  contratos           Contrato[]
  atas                AtaRegistroPreco[]
  penalidades         Penalidade[]

  @@map("fornecedores")
}

// 4. Contratos Administrativos (Regras completas da IN 01/2026 e Lei 14.133)
model Contrato {
  id                          String         @id @default(uuid())
  numeroContrato              String?
  numeroEmpenho               String?
  empenhoSubstituiContrato    Boolean        @default(false)
  processoSeiMae              String
  licitacaoProcedimento       String
  objeto                      String
  vigenciaInicio              DateTime
  vigenciaFim                 DateTime
  anosVigencia                Int?           @default(1) // Duração do contrato em anos (1, 2, 3, etc.) para cálculo plurianual
  valorGlobal                 Float
  valorAtualizado             Float
  valorBaseCalculoAditivos    Float?         @default(0.0) // Base atualizada para fins de limites legais (25% acréscimo / supressão)
  ultimoProcedimentoAtualizacao String?      // Ex: "Apostilamento nº 01/2026 em 18/05/2026, retroagindo a 01/01/2026"
  tipoVigencia                TipoVigencia   @default(NAO_CONTINUADO)
  portariaContinuadosRef      String?
  portariaContinuadosIdSei    String?
  portariaContinuadosUrl      String?
  tipoContrato                TipoContrato   @default(FORNECIMENTO_SIMPLES)
  tipoEmpreitada              TipoEmpreitada @default(PRECO_UNITARIO)
  tipoMedicao                 TipoMedicao    @default(MENSAL)
  dataOrcamentoEstimado       DateTime?      // Data base para reajuste (interregno 1 ano)
  status                      StatusContrato @default(ATIVO)
  motivoEncerramento          String?
  saldoInexequivelJustificativa String?
  fornecedorId                String
  fornecedor                  Fornecedor     @relation(fields: [fornecedorId], references: [id])
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  // Relações
  indicesReajuste             ContratoIndice[]
  itens                       ContratoItem[]
  responsaveis                ContratoResponsavel[]
  trabalhadores               TrabalhadorTerceirizado[]
  convencoesColetivas         ConvenioColetivo[]
  ordensServico               OrdemServico[]
  medicoes                    MedicaoDespesa[]
  movimentacoesContaVinculada ContaVinculadaMovimentacao[]
  penalidades                 Penalidade[]
  alertas                     AlertaSistema[]
  despesasExecucao            DespesaExecucao[]
  planilhasCustos             ContratoPlanilhaCusto[]
  alteracoes                  ContratoAlteracao[]
  imrAvaliacoes               ImrAvaliacao[]
  frequenciasTrabalhadores    FrequenciaTrabalhador[]

  @@map("contratos")
}

// 5. Índices de Reajuste do Contrato
model ContratoIndice {
  id                      String              @id @default(uuid())
  contratoId              String
  contrato                Contrato            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipoIndice              TipoIndiceReajuste
  nomeIndiceSetorial      String?
  justificativaSetorial   String?
  dataBase                DateTime?
  percentualUltimoReajuste Float?

  @@map("contrato_indices")
}

// 6. Itens do Contrato (Travas de 25% Compras/Serviços e 50% Obras)
model ContratoItem {
  id                    String   @id @default(uuid())
  contratoId            String
  contrato              Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numeroItem            Int
  cidade                String?  @default("Mossoró") // Cidade de execução (Mossoró, Assú, Caicó, Patu, Pau dos Ferros, Natal)
  descricao             String
  tipoGrupo             String   @default("ITEM_INDIVIDUAL") // GRUPO_UNICO ou ITEM_INDIVIDUAL
  unidade               String
  quantidadeOriginal    Float
  quantidadeAtual       Float
  valorUnitarioOriginal Float
  valorUnitarioAtual    Float
  valorTotalAnual       Float?   @default(0.0) // Valor anual do posto: a * 12 * qtd
  valorTotalPlurianual  Float?   @default(0.0) // Valor plurianual: a * 12 * anos * qtd (ou 0 se 1 ano)
  valorTotalOriginal    Float
  valorTotalAtual       Float
  limiteAcrescimoPercent Float   @default(25.0) // 25% para compras/serviços e 50% para obras
  tipoReajuste          String   @default("REAJUSTE_INDICE") // REPACTUACAO_CCT, REAJUSTE_INDICE, NAO_REAJUSTAVEL
  indiceReferencia      String?  // Ex: "CCT 2026", "SINAPI", "IPCA"
  cctVinculada          String?  // Nome/Identificação da Convenção Coletiva vinculada (ex: "CCT Motoristas - SINDITRANS", "CCT Supervisores - SINDESP")
  planilhasCustos        ContratoPlanilhaCusto[]

  @@map("contrato_itens")
}

// 7. Equipe de Gestão e Fiscalização por Contrato (IN 01/2026)
model ContratoResponsavel {
  id                   String   @id @default(uuid())
  contratoId           String
  contrato             Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  tipoAtuacao          Role     // GESTOR, SUPLENTE, FISCAL_ADMINISTRATIVO, FISCAL_TECNICO, FISCAL_SETORIAL
  numeroAtoDesignacao  String
  idSeiAtoDesignacao   String
  campusSetor          String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([contratoId, userId, tipoAtuacao])
  @@map("contrato_responsaveis")
}

// 8. Atas de Registro de Preço (ARP)
model AtaRegistroPreco {
  id                  String     @id @default(uuid())
  numeroAta           String
  ano                 Int
  processoSei         String
  objeto              String
  gestorId            String?
  gestor              User?      @relation(fields: [gestorId], references: [id])
  fornecedorId        String
  fornecedor          Fornecedor @relation(fields: [fornecedorId], references: [id])
  vigenciaInicio      DateTime
  vigenciaFim         DateTime
  valorGlobalOriginal Float
  valorGlobalAtual    Float
  status              String     @default("VIGENTE")
  indiceReajuste      String?    @default("IPCA")
  dataUltimoReajuste  DateTime?
  percentualUltimoReajuste Float?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  itens               AtaItem[]
  adesoes             AtaAdesao[]
  autorizacoesExecucao AtaAutorizacaoExecucao[]

  @@map("atas_registro_preco")
}

model AtaItem {
  id                   String           @id @default(uuid())
  ataId                String
  ata                  AtaRegistroPreco @relation(fields: [ataId], references: [id], onDelete: Cascade)
  numeroItem           Int
  descricao            String
  marcaModelo          String?
  unidade              String
  quantidadeRegistrada Float
  quantidadeSaldo      Float
  valorUnitario        Float
  valorTotal           Float

  @@map("ata_itens")
}

model AtaAdesao {
  id                 String           @id @default(uuid())
  ataId              String
  ata                AtaRegistroPreco @relation(fields: [ataId], references: [id], onDelete: Cascade)
  orgaoRequisitante  String
  tipoOrgao          String           @default("NAO_PARTICIPANTE_CARONA")
  processoSeiAdesao  String
  valorAdesao        Float            @default(0)
  percentualAdesao   Float            @default(0) // Limite de 50% por carona (Lei 14.133)
  statusAprovacao    String           @default("PENDENTE") // PENDENTE, AUTORIZADA, INDEFERIDA
  dataAprovacao      DateTime?
  justificativa      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("ata_adesoes")
}

model AtaAutorizacaoExecucao {
  id                  String           @id @default(uuid())
  ataId               String
  ata                 AtaRegistroPreco @relation(fields: [ataId], references: [id], onDelete: Cascade)
  numeroAutorizacao   String           // Ex: UERN-AEA-001/2026
  processoSei         String
  orgaoRequisitante   String           // Ex: Campus Mossoró, PROAD, etc.
  descricao           String
  valorTotal          Float
  status              String           @default("AUTORIZADA") // PENDENTE, AUTORIZADA, CANCELADA
  dataAutorizacao     DateTime         @default(now())
  observacoes         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("ata_autorizacoes_execucao")
}

// 9. Módulo de Terceirização (Dedicação Exclusiva de Mão de Obra)
model TrabalhadorTerceirizado {
  id               String   @id @default(uuid())
  contratoId       String
  contrato         Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  nomeCompleto     String
  cpf              String
  funcao           String
  campus           String?  // Ex: "Campus Central (Mossoró)", "Campus Natal", etc.
  setorLotacao     String?  // Ex: "Complexo Cultural", "Prédio da Reitoria", "FAS"
  jornada          String?  // Ex: "44h semanais", "Escala 12x36"
  sexo             String?
  dataNascimento   DateTime?
  dataAdmissao     DateTime
  dataDemissao     DateTime?
  banco            String?
  agencia          String?
  contaCorrente    String?
  cctVinculada     String?  // Convenção Coletiva à qual o trabalhador está vinculado (ex: "CCT Motoristas")
  salarioBaseCct   Float
  beneficiosInfo   String?
  status           String   @default("ATIVO") // ATIVO, AFASTADO, DEMITIDO, SUBSTITUIDO
  createdAt        DateTime @default(now())

  movimentacoesContaVinculada ContaVinculadaMovimentacao[]
  documentos                  DocumentoTrabalhador[]
  frequencias                 FrequenciaTrabalhador[]

  @@map("trabalhadores_terceirizados")
}

model DocumentoTrabalhador {
  id                String                  @id @default(uuid())
  trabalhadorId     String
  trabalhador       TrabalhadorTerceirizado @relation(fields: [trabalhadorId], references: [id], onDelete: Cascade)
  tipoDocumento     String                  // CTPS_DIGITAL, ASO_ADMISSIONAL, ASO_PERIODICO, FICHA_REGISTRO, CONTA_BANCARIA, COMPROVANTE_ESCOLARIDADE, CERTIDAO_NEGATIVA, OUTROS
  nomeArquivo       String
  arquivoUrl        String
  statusConferencia String                  @default("PENDENTE") // PENDENTE, CONFERIDO, INCONFORME
  observacoes       String?
  enviadoEm         DateTime                @default(now())

  @@map("trabalhador_documentos")
}

model FrequenciaTrabalhador {
  id                   String                  @id @default(uuid())
  trabalhadorId        String
  trabalhador          TrabalhadorTerceirizado @relation(fields: [trabalhadorId], references: [id], onDelete: Cascade)
  contratoId           String
  contrato             Contrato                @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  competenciaMesAno    String                  // Ex: "03/2026"
  diasPrevistos        Int                     @default(30)
  diasTrabalhados      Int                     @default(30)
  faltasInjustificadas Int                     @default(0)
  faltasJustificadas   Int                     @default(0)
  diasSubstituidos     Int                     @default(0)
  valorGlosaSugerida   Float                   @default(0.0)
  statusApuracao       String                  @default("EM_APURACAO") // EM_APURACAO, CONFERIDO, APLICADO_MEDICAO
  observacoes          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([trabalhadorId, competenciaMesAno])
  @@map("trabalhador_frequencias")
}

model ConvenioColetivo {
  id                 String    @id @default(uuid())
  contratoId         String
  contrato           Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  nomeConvencao      String?   // Nome amigável (ex: "CCT Motoristas - SINDITRANS", "CCT Supervisores - SINDESP")
  numeroRegistroMte  String?
  sindicatoLaboral   String?
  sindicatoPatronal  String?
  dataBase           String?   // Mês da data-base (ex: "Maio", "Janeiro", "01/05")
  vigenciaInicio     DateTime?
  vigenciaFim        DateTime?
  dataAssinatura     DateTime?
  arquivoPdfUrl      String?
  categoriasProfissionais String?
  itensFiscalizacao       Json?    // Estrutura com salarios, beneficios, obrigacoesComPagamento, obrigacoesSemPagamento
  createdAt          DateTime  @default(now())

  funcoes                 ConvenioColetivoFuncao[]

  @@map("convencoes_coletivas")
}

model ConvenioColetivoFuncao {
  id                   String           @id @default(uuid())
  convenioId           String
  convenio             ConvenioColetivo @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  nomeFuncao           String
  salarioPiso          Float
  beneficioAlimentacao Float?
  beneficioTransporte  Float?
  outrosBeneficios     String?

  @@map("convenio_funcoes")
}

// 9.1. Planilhas de Composição de Custos e Formação de Preços (IN 05/2017 e IN 01/2026)
model ContratoPlanilhaCusto {
  id                     String        @id @default(uuid())
  contratoId             String
  contrato               Contrato      @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  itemId                 String?
  item                   ContratoItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  numeroItem             Int?
  funcao                 String        // Nome da função (ex: Supervisor Operacional)
  cbo                    String?       // Código CBO
  municipio              String?       // Município de execução
  jornada                String?       // Carga horária semanal (ex: 44h)
  cctReferencia          String?       // Registro CCT de referência
  mesesExecucao          Int           @default(12)
  quantidadeEmpregados   Int           @default(1)
  quantidadePostos       Int           @default(1)
  salarioBase            Float
  totalModulo1           Float         // Composição da Remuneração
  totalModulo2           Float         // Encargos e Benefícios Anuais, Mensais e Diários
  totalModulo3           Float         // Provisão para Rescisão
  totalModulo4           Float         // Custo de Reposição do Profissional Ausente
  totalModulo5           Float         // Insumos Diversos
  totalModulo6           Float         // Custos Indiretos, Tributos e Lucro
  custosIndiretosPercent Float?       // % Custos indiretos
  lucroPercent           Float?        // % Lucro
  tributosPercent        Float?        // % Tributos (PIS, COFINS, ISS)
  precoTotalEmpregado    Float         // Custo total por empregado (mensal)
  valorMensalTotal       Float         // Total mensal do posto/serviço
  valorGlobalTotal       Float         // Total global (meses x mensal)
  fatorK                 Float?        // Fator K multiplicador
  dadosDetalhados        Json?         // Detalhamento item a item dos submódulos e insumos
  arquivoOriginalNome    String?
  arquivoOriginalUrl     String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@map("contratos_planilhas_custos")
}

// 10. Execução: Ordem de Serviço com Assinatura Eletrônica (IN 01/2026)
model OrdemServico {
  id                       String    @id @default(uuid())
  contratoId               String
  contrato                 Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numeroOs                 String
  ano                      Int
  fiscalAdmId              String
  fiscalAdm                User      @relation(fields: [fiscalAdmId], references: [id])
  processoSeiDespesa       String
  descricaoServico         String
  valorEstimado            Float
  dataEmissao              DateTime  @default(now())
  hashAssinaturaEletronica String
  status                   String    @default("EMITIDA")
  arquivoPdfUrl            String?
  createdAt                DateTime  @default(now())

  medicoes                 MedicaoDespesa[]

  @@map("ordens_servico")
}

// 11. Medição, Controle de Saldo e Atestes
model MedicaoDespesa {
  id                        String        @id @default(uuid())
  contratoId                String
  contrato                  Contrato      @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  ordemServicoId            String?
  ordemServico              OrdemServico? @relation(fields: [ordemServicoId], references: [id])
  referenciaMesAno          String        // Ex: 03/2026
  processoSeiDespesa        String
  numeroNotaFiscal          String?
  dataEmissaoNf             DateTime?
  valorNotaFiscal           Float?
  valorGlosa                Float         @default(0.0)
  motivoGlosa               String?
  valorAtestadoFinal        Float?
  dataRecebimentoProvisorio DateTime?     // Fiscal Técnico
  dataRecebimentoDefinitivo DateTime?     // Gestor do Contrato
  status                    StatusMedicao @default(AGUARDANDO_ENVIO_NF)
  createdAt                 DateTime      @default(now())

  @@map("medicoes_despesa")
}

// 12. Conta Vinculada (Fórmulas do Caderno de Logística)
model ContaVinculadaMovimentacao {
  id                  String                     @id @default(uuid())
  contratoId          String
  contrato            Contrato                   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  trabalhadorId       String?
  trabalhador         TrabalhadorTerceirizado?   @relation(fields: [trabalhadorId], references: [id])
  competenciaMesAno   String                     // MM/AAAA
  rubrica             RubricaContaVinculada
  tipoOperacao        TipoOperacaoContaVinculada
  valor               Float
  saldoAnterior       Float
  saldoAtual          Float
  numeroOficio        String?
  motivoLiberacao     String?
  createdAt           DateTime                   @default(now())

  @@map("conta_vinculada_movimentacoes")
}

// 13. Penalidades e Sanções (IN 01/2026 - Prazos de 15 dias de defesa e recurso)
model Penalidade {
  id                     String           @id @default(uuid())
  contratoId             String
  contrato               Contrato         @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  fornecedorId           String
  fornecedor             Fornecedor       @relation(fields: [fornecedorId], references: [id])
  tipoPenalidade         TipoPenalidade
  fatosDescricao         String
  baseLegal              String
  status                 StatusPenalidade @default(NOTIFICACAO_DEFESA_15_DIAS)
  protocoloNotificacaoSei String?
  dataEnvioNotificacao   DateTime         @default(now())
  prazoDefesaFim         DateTime
  dataDefesaApresentada  DateTime?
  protocoloDecisaoSei    String?
  impactoScore           Float            @default(5.0)
  createdAt              DateTime         @default(now())

  @@map("penalidades")
}

// 14. Alertas do Sistema (Vigência, Saldo < Média 12, Prazos CCT, CNDs)
model AlertaSistema {
  id             String      @id @default(uuid())
  contratoId     String?
  contrato       Contrato?   @relation(fields: [contratoId], references: [id])
  destinatarioId String
  destinatario   User        @relation(fields: [destinatarioId], references: [id])
  tipoAlerta     String
  nivel          NivelAlerta @default(INFO)
  titulo         String
  mensagem       String
  lido           Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@map("alertas_sistema")
}

// 15. Rascunhos de Contratos (Persistência segura no banco Neon)
model ContratoRascunho {
  id                  String   @id @default(uuid())
  usuarioId           String
  usuario             User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tituloIdentificador String?
  numeroContrato      String?
  processoSei         String?
  objeto              String?
  dados               Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("contrato_rascunhos")
}

// 16. Despesas de Execução e Saldo de Contratos (Campi UERN)
model DespesaExecucao {
  id                    String    @id @default(uuid())
  contratoId            String
  contrato              Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numeroContratoRef     String?
  processoSeiMaeRef     String?
  processoSeiDespesa    String    // Processo SEI da Despesa
  numeroNotaFiscal      String?   // Nº da Nota Fiscal
  dataAtesto            DateTime? // Data do Atesto
  referencia            String    // Mês/ano ou nº Medição/ano
  cidade                String    // Mossoró, Assú, Patu, Pau dos Ferros, Caicó ou Natal
  valorEstimado         Float     @default(0.0) // Processo aberto com valor estimado (empenhado)
  valorAtestado         Float     @default(0.0) // Real atestado
  saldo                 Float     @default(0.0) // Saldo aberto / a atestar
  status                String    @default("ABERTA") // ABERTA, ATESTADA, PAGA, CANCELADA
  observacoes           String?

  // Encerramento do Exercício / Fechamento Contábil Anual (IN 01/2026)
  decisaoContabil       String    @default("MANTER") // MANTER (há perspectiva de execução) ou ANULAR_CANCELAR (anular empenho)
  justificativaContabil String?   // Parecer contábil/operacional registrado pelo Gestor/Fiscal
  anoExercicio          Int?      // Ano contábil do exercício financeiro (ex: 2026)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("despesas_execucao")
}

// 17. Registro de Alterações Contratuais com Versionamento Imutável (Histórico e Timeline)
enum TipoAlteracaoContratual {
  REAJUSTE_APOSTILAMENTO
  REPACTUACAO_APOSTILAMENTO
  REEQUILIBRIO_ADITIVO
  ACRESCIMO_ADITIVO
  SUPRESSAO_ADITIVO
  PRORROGACAO_ADITIVO
  OUTRAS_ADITIVO
}

model ContratoAlteracao {
  id                        String                   @id @default(uuid())
  contratoId                String
  contrato                  Contrato                 @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipoAlteracao             TipoAlteracaoContratual
  instrumento               String                   // APOSTILAMENTO ou TERMO_ADITIVO
  numeroTermo               String                   // Ex: "Apostilamento nº 01/2026" ou "1º Termo Aditivo"
  processoSei               String
  documentoSeiId            String
  dataAssinatura            DateTime
  possuiEfeitoRetroativo    Boolean                  @default(false)
  dataRetroatividade        DateTime?                // Data a partir da qual os novos valores produzem efeitos
  valorAnterior             Float
  valorAjuste               Float                    // Valor acrescentado (+) ou suprimido (-)
  novoValorGlobal           Float
  novaBaseCalculoAditivos   Float                    // Nova base para limites de 25% (ou 50%)
  vigenciaAnterior          DateTime?
  novaVigenciaFim           DateTime?
  justificativa             String?
  itensSnapshotAnterior     Json?                    // Snapshot dos itens antes da alteração
  itensSnapshotAtualizado   Json?                    // Snapshot dos itens atualizados
  calculoResidualJson       Json?                    // Demonstrativo das faturas recalculadas
  valorResidualTotal        Float                    @default(0.0)
  status                    String                   @default("ATIVO")
  criadoPorId               String
  criadoPor                 User                     @relation(fields: [criadoPorId], references: [id])
  createdAt                 DateTime                 @default(now())

  @@map("contrato_alteracoes")
}

// 18. Avaliações de IMR (Instrumento de Medição de Resultado - Anexo I IN 01/2026)
model ImrAvaliacao {
  id                 String   @id @default(uuid())
  contratoId         String
  contrato           Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  mesCompetencia     String   // MM/AAAA
  localCampus        String   // Mossoró, Assú, Caicó, Patu, Pau dos Ferros, Natal
  totalPontos        Float    @default(0.0)
  percentualGlosa    Float    @default(0.0) // Calculado conforme tabela de pontuação
  valorGlosa         Float    @default(0.0)
  observacoes        String?
  fiscalNome         String?
  fiscalMatricula    String?
  status             String   @default("CONCLUIDO") // RASCUNHO, CONCLUIDO, NOTIFICADO
  itens              Json     // Lista detalhada das ocorrências, pontuações e docs SEI
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("imr_avaliacoes")
}



